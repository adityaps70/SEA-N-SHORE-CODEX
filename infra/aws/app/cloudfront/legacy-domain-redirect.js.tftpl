// Sea N Shore legacy domain redirect (CloudFront Functions, runtime cloudfront-js-2.0).
// Every request that reaches the seaandshore.in redirect distribution (http or https, apex or
// www) is answered with a 301 to https://seanshore.in. Known pages of the old website map to
// their new locations; every other path is kept as-is (the new site renders a proper 404), and
// the query string always travels with the redirect.
var CANONICAL_HOST = '${canonical_host}';

// Lower-case old path -> new path. Keys must be exact paths (no query string).
var PATH_MAP = {
  '/index.html': '/',
  '/index.php': '/',
  '/faqs': '/help',
  '/faqs/': '/help',
  '/faqs/index.html': '/help',
  '/help.html': '/help',
  '/help.php': '/help',
  '/about.php': '/about',
  '/contact.php': '/contact',
  '/legal.php': '/terms',
  '/terms-and-conditions.php': '/terms',
  '/privacy-policy.php': '/privacy',
  '/mentor.php': '/',
  '/photo-gallery.php': '/',
  '/pages/jobs/joblisting.php': '/jobs',
  '/pages/candidatesearch/candidatelisting.php': '/network',
  '/pages/communitymember/communitymembers.php': '/community',
  '/pages/login/clientlogin.php': '/auth/sign-in',
};

function encodeQueryPart(value) {
  return encodeURIComponent(value)
    .replace(/%25([0-9A-Fa-f]{2})/g, '%$1')
    .replace(/%2B/g, '+');
}

function buildQueryString(querystring) {
  var parts = [];
  var keys = Object.keys(querystring || {});
  for (var i = 0; i < keys.length; i++) {
    var key = keys[i];
    var entry = querystring[key];
    var values = entry && entry.multiValue ? entry.multiValue : [entry];
    for (var j = 0; j < values.length; j++) {
      var value = values[j] && typeof values[j].value === 'string' ? values[j].value : '';
      parts.push(encodeQueryPart(key) + '=' + encodeQueryPart(value));
    }
  }
  return parts.length ? '?' + parts.join('&') : '';
}

function mapPath(uri) {
  var lower = (uri || '/').toLowerCase();
  if (Object.prototype.hasOwnProperty.call(PATH_MAP, lower)) return PATH_MAP[lower];
  // The old FAQ lived under /FAQs/...; every FAQ sub-page now lives on the help page.
  if (lower.indexOf('/faqs/') === 0) return '/help';
  return uri;
}

function handler(event) {
  var request = event.request;
  return {
    statusCode: 301,
    statusDescription: 'Moved Permanently',
    headers: {
      location: { value: 'https://' + CANONICAL_HOST + mapPath(request.uri) + buildQueryString(request.querystring) },
      'cache-control': { value: 'public, max-age=3600' },
    },
  };
}
